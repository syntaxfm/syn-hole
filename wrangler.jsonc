{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "syn-hole",
  "account_id": "3ebe60b8bb090efeda7702aff60769bb",
  "main": "src/server.ts",
  "compatibility_date": "2026-03-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "live.syntax.fm",
      "custom_domain": true,
    },
  ],
  "r2_buckets": [
    {
      "binding": "POLL_IMAGES",
      "bucket_name": "syn-hole-poll-images",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PollRoom",
        "class_name": "PollRoom",
      },
      {
        "name": "AdminRegistry",
        "class_name": "AdminRegistry",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PollRoom"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["AdminRegistry"],
    },
  ],
}
